# 실제 값은 .env 에 두고 커밋하지 않는다.
# 아무 자격증명도 없으면 서버는 목 모드로 뜨고, /forge 응답 형태는 동일하다.
#
# 스탯과 이미지는 제공자가 다르다. Gemini 스탯은 무료 티어에서 잘 돌지만
# Gemini 이미지 모델은 무료 할당이 0이어서(실측) 쓸 수 없었다.
# 한쪽만 넣어도 그쪽만 동작하고, 없는 쪽은 폴백으로 처리된다.

# ── 스탯: 그림 + 설명 → 이름·공격력·연사·탄속·사거리 ──
# https://aistudio.google.com/apikey — 무료 티어로 충분하다
GEMINI_API_KEY=
GEMINI_STATS_MODEL=gemini-flash-latest

# ── 무기 그림 1·2단계 (image-to-image) ──
# 둘 중 하나만 채우면 된다. 둘 다 있으면 Cloudflare를 쓴다.

# [권장] Cloudflare Workers AI — 하루 10,000 뉴런 무료, 카드 등록 불필요
#   계정: https://dash.cloudflare.com/sign-up
#   Account ID: 대시보드 URL의 dash.cloudflare.com/<account_id>
#   Token: My Profile → API Tokens → Create Token → Workers AI 템플릿
# img2img의 strength로 단계를 숫자로 제어한다 (1단계 0.35 / 2단계 0.80).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/runwayml/stable-diffusion-v1-5-img2img

# OpenAI — 무료 티어 없음. 크레딧이 있어야 동작한다.
#   잔액 0이면 billing_hard_limit_reached(400)가 돌아온다.
#   https://platform.openai.com/api-keys
OPENAI_API_KEY=
# gpt-image-1 은 2026-10-23 지원 종료 예정이라 쓰지 않는다
OPENAI_IMAGE_MODEL=gpt-image-1.5

# 둘 다 있을 때 한쪽을 강제하고 싶으면 cloudflare 또는 openai
IMAGE_PROVIDER=

# 자격증명이 있어도 목으로 강제하고 싶을 때
FORGE_MODE=

PORT=8790
HOST=127.0.0.1
# 이미지 생성이 느릴 수 있어 넉넉히
FORGE_TIMEOUT_S=180
