# 실제 값은 .env 에 두고 커밋하지 않는다.
# 키가 없으면 서버는 목 모드로 뜨고, /forge 응답 형태는 동일하다.

# https://aistudio.google.com/apikey — 무료 티어 있음
GEMINI_API_KEY=

# 그림 + 메모 → 스탯 JSON (비전 모델)
GEMINI_STATS_MODEL=gemini-flash-latest

# 그림 → 무기 이미지 (이미지 출력 모델)
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# 키가 있어도 목으로 강제하고 싶을 때
FORGE_MODE=

PORT=8790
HOST=127.0.0.1
FORGE_TIMEOUT_S=60
